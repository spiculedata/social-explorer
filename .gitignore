# Environment — never commit secrets
.env
.env.*
!.env.example

# Secrets and key material
*.pem
*.key
secrets.json

# Runtime bind-mounted data (databases, uploads, crawls, IPFS blocks; see DATA_DIR in .env.example)
/data/

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Logs
logs/
*.log

# Temp / scratch
temp/

# Local AI-assistant tooling (per-developer; see .mcp.json.example). Per-user state under .claude/
# stays ignored; the shared agent settings, memory and skills link are committed (AGENTS.md).
.claude/*
!.claude/settings.json
!.claude/memory/
!.claude/session-summary.md
!.claude/skills
.pi/
.mcp.json

# Runtime data and model weights (multi-GB, contains recorded broadcasts and transcripts)
wavepulse/assets/data/
wavepulse/assets/models/

# Generated documentation build output
crawler/docs/_site/

# Third-party Superset checkout (2 GB clone of apache/superset); use the official image instead
/superset/

# Personal Claude Code instructions
CLAUDE.local.md

# Documentation screenshot run output
ex-accell-ui/test-results-screenshots/

# Jupyter
.ipynb_checkpoints/
