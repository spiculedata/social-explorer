      "Bash(gh pr close *)",
      "Bash(gh release *)",
      "Bash(gh workflow run *)",
      "Bash(gh workflow enable *)",
      "Bash(gh workflow disable *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh label *)",
      "Bash(gh api -X *)",
      "Bash(git tag *)",
      "Bash(docker compose *)",
      "Bash(docker push *)",
      "Bash(docker login *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(scw *)",
      "Bash(npm publish *)",
      "Bash(npm run dapr:*)",
      "Bash(npm run seed:demo)",
      "Bash(npm run demo*)",
      "Edit(/.github/workflows/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/SECURITY.md)",
      "Edit(/docs/security/**)",
      "Edit(/docker-compose.yml)",
      "Edit(/deploy/**)",
      "Edit(/.env.example)",
      "Edit(/ex-accell-ui/secrets.example.json)",
      "Edit(/ex-accell-ui/db/migrations/**)",
      "Edit(/ex-accell-ui/src/hooks.server.ts)",
