      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:unit:coverage)",
      "Bash(npm run docs:build)",
      "Bash(npm run wiki:test)",
      "Bash(npx vitest run *)",
      "Bash(npm audit *)",
      "Bash(python3 -m pytest *)",
      "Bash(python -m pytest *)",
      "Bash(pytest *)",
      "Bash(ruff check *)",
      "Bash(node --test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git blame *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
