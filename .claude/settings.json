      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/secrets.json)",
      "Read(**/*.secret)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.scw/**)",
      "Read(~/.config/scw/**)",
      "Read(wavepulse/assets/data/**)",
      "Read(wavepulse/assets/models/**)",
      "Read(data/**)"
