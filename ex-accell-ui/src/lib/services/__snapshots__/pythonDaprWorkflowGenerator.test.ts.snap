"#!/usr/bin/env python3
"""Generated Python Dapr workflow script (pure Dapr Python SDK)."""

import asyncio
import json
import sys
import logging
import traceback
from datetime import datetime, timedelta
from typing import Dict, Any, List

# Dapr imports - following official Python SDK examples
from dapr.ext.workflow import (
    WorkflowRuntime,
    DaprWorkflowContext,
    WorkflowActivityContext,
    DaprWorkflowClient,
    RetryPolicy
)

# Data processing imports
import pandas as pd
import numpy as np
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
from textblob import TextBlob
import nltk

# Download required NLTK data
try:
    nltk.data.find('tokenizers/punkt')
except LookupError:
    nltk.download('punkt', quiet=True)

try:
    nltk.data.find('corpora/stopwords')
except LookupError:
    nltk.download('stopwords', quiet=True)

# Setup logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Workflow metadata. These are Python string literals rendered with JSON escaping, never raw text:
# a workflow name or description cannot close the literal and inject code.
WORKFLOW_NAME = "Step Under Test"
WORKFLOW_DESCRIPTION = "A test workflow"

# Global data storage for workflow
workflow_data = {}

# ============================================================================
# WORKFLOW ACTIVITIES
# ============================================================================

def load_data_activity(ctx: WorkflowActivityContext, input_data: Dict[str, Any]) -> Dict[str, Any]:
    """Load data activity"""
    try:
        dataset_id = input_data.get('dataset', 'default')
        logger.info(f"Loading dataset: {dataset_id}")
        
        # TODO: Implement actual data loading from unified database
        # For now, create sample data
        sample_data = pd.DataFrame({
            'text': [
                'This is great!',
                'I love this product',
                'Not very good quality',
                'Amazing service and support',
                'Could be better'
            ] * 20,  # Sample data
            'category': ['electronics', 'books', 'clothing', 'services', 'food'] * 20
        })
        
        # Store data globally (in production, use proper state management)
        workflow_data[ctx.instance_id] = sample_data
        
